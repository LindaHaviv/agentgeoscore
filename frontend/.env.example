# Copy to .env.local during development. Vite will pick it up.
#
# All variables are OPTIONAL. The dev server in vite.config.ts proxies /api/*
# to http://localhost:8000, so a local backend works without any env config.

# Production backend URL — used when the frontend bundle is deployed to a
# different origin than the backend. Set to the Fly app URL (or your own
# deployment) for prod builds. Leave unset for `npm run dev` against a
# local backend.
VITE_API_BASE=https://agentgeoscore-1ei53w.fly.dev
