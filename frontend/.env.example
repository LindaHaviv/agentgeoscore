# Copy to .env.local during development. Vite will pick it up.
#
# All variables are OPTIONAL. The dev server in vite.config.ts proxies /api/*
# to http://localhost:8000, so a local backend works without any env config.

# Production backend URL — used when the frontend bundle is deployed to a
# different origin than the backend. Set to the Fly app URL (or your own
# deployment) for prod builds. Leave unset for `npm run dev` against a
# local backend.
VITE_API_BASE=https://agentgeoscore-1ei53w.fly.dev

# Production *frontend* origin. The build pipeline rewrites every literal
# https://dist-olcivbch.devinapps.com in the static SEO shell, robots.txt,
# sitemap.xml, llms.txt, and .well-known/security.txt to this value.
#
# Leave unset to default to https://dist-olcivbch.devinapps.com.
# When the production domain ships, set this to the new origin (no trailing
# slash) and rebuild — that one env change cuts over canonical, og:url,
# every JSON-LD url/@id, the sitemap loc entries, and the security.txt
# Canonical line.
# VITE_FRONTEND_ORIGIN=https://agentgeoscore.com
