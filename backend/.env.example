# Copy this file to ``.env`` and fill in the values you need.
# All variables are OPTIONAL: with none set, the backend still serves
# scans, but live citation probes + Core Web Vitals will return ``skip``.
#
# DO NOT commit ``.env`` (it is git-ignored at the repo root).

# ─── Citation probes ────────────────────────────────────────────────────────
# Each probe checks whether AI engines cite the scanned site for queries
# derived from its content. All keys come from the providers' free tiers.

# Groq — fast llama-3.3-70b inference. Used both as a citation probe and
# (if set) to polish the AI-search test prompts into natural language.
# https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini — citation probe with native web access.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Mistral — optional citation probe (heavy overlap with Groq for most
# verticals; skip if you don't care about EU/Le Chat coverage).
# https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Brave Search — proxy signal for Perplexity (Perplexity uses Brave's index).
# Free plan: 2,000 queries/month, no credit card.
# https://api-dashboard.search.brave.com/
BRAVE_API_KEY=

# ─── Core Web Vitals ────────────────────────────────────────────────────────
# Google PageSpeed Insights — needed for the CWV scanner. Free tier is
# generous (~25k req/day with a key vs 1 req/sec without).
# https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# ─── Deploy / runtime ───────────────────────────────────────────────────────

# Frontend origin used in 302 redirects from ``/share`` and as the default
# CORS allowlist entry. Override in prod if your frontend lives elsewhere.
FRONTEND_ORIGIN=http://localhost:5173

# Pin the public backend origin if your deploy lives behind a CDN that
# rewrites the ``Host`` header. Leave unset to derive from the request.
BACKEND_ORIGIN=

# Comma-separated CORS allowlist. Defaults to FRONTEND_ORIGIN +
# localhost:5173. Set to ``*`` only for local dev — never in prod.
# ALLOWED_ORIGINS=https://your-frontend.example.com

# ─── Optional toggles ───────────────────────────────────────────────────────

# Disable the duck.ai citation probe (its session-token rotation is
# aggressive; in prod we leave it enabled and let it skip cleanly).
# DISABLE_DUCK_AI=1
